rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function pairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function friendsWith(uid) {
      return verified()
        && firestore.exists(/databases/(default)/documents/friendships/$(pairId(request.auth.uid, uid)))
        && firestore.get(/databases/(default)/documents/friendships/$(pairId(request.auth.uid, uid))).data.status == 'active'
        && request.auth.uid in firestore.get(/databases/(default)/documents/friendships/$(pairId(request.auth.uid, uid))).data.memberUids;
    }

    function conversationMember(conversationId) {
      return verified()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberUids
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.status == 'active';
    }

    function uploadTicket(conversationId, messageId) {
      return firestore.exists(/databases/(default)/documents/mediaUploads/$(messageId))
        && firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.conversationId == conversationId
        && firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.senderUid == request.auth.uid
        && firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.storagePath == 'conversations/' + conversationId + '/messages/' + messageId + '/media'
        && firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.uploadExpiresAt > request.time;
    }

    function validTicketedMedia(conversationId, messageId) {
      return uploadTicket(conversationId, messageId)
        && request.resource.size == firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.bytes
        && request.resource.contentType == firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.contentType
        && request.resource.cacheControl == 'private, max-age=0, no-store'
        && (
          (
            firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.type == 'image'
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
          )
          || (
            firestore.get(/databases/(default)/documents/mediaUploads/$(messageId)).data.type == 'video'
            && request.resource.size <= 50 * 1024 * 1024
            && request.resource.contentType in ['video/mp4', 'video/webm']
          )
        );
    }

    function statusUploadTicket(statusId) {
      return firestore.exists(/databases/(default)/documents/statusUploads/$(statusId))
        && firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.ownerUid == request.auth.uid
        && firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.storagePath == 'statuses/' + statusId + '/media'
        && firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.uploadExpiresAt > request.time;
    }

    function validStatusTicketedMedia(statusId) {
      return statusUploadTicket(statusId)
        && request.resource.size == firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.bytes
        && request.resource.contentType == firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.contentType
        && request.resource.cacheControl == 'private, max-age=0, no-store'
        && (
          (
            firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.type == 'image'
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
          )
          || (
            firestore.get(/databases/(default)/documents/statusUploads/$(statusId)).data.type == 'video'
            && request.resource.size <= 50 * 1024 * 1024
            && request.resource.contentType in ['video/mp4', 'video/webm']
          )
        );
    }

    match /users/{uid}/avatar/{assetId} {
      allow read: if verified();
      allow write: if verified()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /conversations/{conversationId}/messages/{messageId}/{assetId} {
      allow read: if conversationMember(conversationId)
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId))
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId)).data.expiresAt > request.time
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)/messages/$(messageId)).data.storagePath == 'conversations/' + conversationId + '/messages/' + messageId + '/media';
      allow create: if verified()
        && conversationMember(conversationId)
        && assetId == 'media'
        && validTicketedMedia(conversationId, messageId);
      allow update: if false;
      allow delete: if false;
    }

    match /statuses/{statusId}/{assetId} {
      allow read: if verified()
        && firestore.exists(/databases/(default)/documents/statuses/$(statusId))
        && firestore.get(/databases/(default)/documents/statuses/$(statusId)).data.expiresAt > request.time
        && (
          firestore.get(/databases/(default)/documents/statuses/$(statusId)).data.ownerUid == request.auth.uid
          || friendsWith(firestore.get(/databases/(default)/documents/statuses/$(statusId)).data.ownerUid)
        );
      allow create: if verified()
        && assetId == 'media'
        && validStatusTicketedMedia(statusId);
      allow update, delete: if false;
    }
  }
}
