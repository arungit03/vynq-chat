# Enable only after Firebase App Check has been registered and the web app is
# configured with NEXT_PUBLIC_ENABLE_FIREBASE_APP_CHECK=true.
VYNQ_ENFORCE_APP_CHECK=false

# Required to create the private presence/typing access mirrors after two
# people become friends. This is the Realtime Database URL, not a secret.
FIREBASE_DATABASE_URL=https://vynq-chat-default-rtdb.firebaseio.com
