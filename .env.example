# Firebase web config (from Firebase Console → Project settings → Your apps)
# These are public* web config values (safe to expose in a client app),
# but should still come from environment variables, never hardcoded.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: App Check debug token for local dev (leave empty in production)
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
