# Firebase Web App configuration.
# These values are intentionally NEXT_PUBLIC_* because Firebase web config is
# delivered to the browser. Authorization is enforced by Firebase Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vynq-chat.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://vynq-chat-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vynq-chat
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vynq-chat.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace-me
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional abuse protection. Register a reCAPTCHA v3 provider in Firebase App
# Check before enabling this. Set the matching Functions value to true only
# after clients are sending valid App Check tokens.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_ENABLE_FIREBASE_APP_CHECK=false

# Set to true only when running the Firebase Local Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
