rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function self(uid) {
      return verified() && request.auth.uid == uid;
    }

    function pairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function friendshipExists(uidA, uidB) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(uidA, uidB)));
    }

    function friendsWith(uid) {
      return verified()
        && friendshipExists(request.auth.uid, uid)
        && get(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))).data.memberUids;
    }

    function conversationMember(conversationId) {
      return verified()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberUids
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'active';
    }

    function activeStatus(statusId) {
      return exists(/databases/$(database)/documents/statuses/$(statusId))
        && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time;
    }

    match /users/{uid} {
      allow read: if verified();
      // Profiles are created and changed only by verified server callables so
      // username and ownership invariants cannot be bypassed from a client.
      allow write: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if verified();
      allow write: if false;
    }

    match /followRequests/{requestId} {
      allow read: if verified()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      // Requests are server-authoritative and rate-limited in Cloud Functions.
      allow write: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if verified() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if conversationMember(conversationId);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if conversationMember(conversationId)
          && resource.data.expiresAt > request.time;
        // Text and media messages are created by rate-limited Functions only,
        // which assign the exact 24-hour expiry and validate all media.
        allow create: if false;
        allow update: if conversationMember(conversationId)
          && resource.data.expiresAt > request.time
          && resource.data.senderUid != request.auth.uid
          && resource.data.readAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    // Server-issued, short-lived upload tickets. These never contain media
    // URLs and are intentionally inaccessible from browser clients.
    match /mediaUploads/{messageId} {
      allow read, write: if false;
    }

    match /statusUploads/{statusId} {
      allow read, write: if false;
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /statuses/{statusId} {
      allow read: if verified()
        && resource.data.expiresAt > request.time
        && (resource.data.ownerUid == request.auth.uid || friendsWith(resource.data.ownerUid));
      allow write: if false;

      match /viewers/{uid} {
        allow read: if verified()
          && activeStatus(statusId)
          && (request.auth.uid == uid || get(/databases/$(database)/documents/statuses/$(statusId)).data.ownerUid == request.auth.uid);
        allow create: if self(uid)
          && activeStatus(statusId)
          && request.resource.data.keys().hasOnly(['uid', 'seenAt'])
          && request.resource.data.uid == uid
          && request.resource.data.seenAt == request.time;
        allow update, delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }
  }
}
