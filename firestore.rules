rules_version = '2';

// Vynq-chat Firestore security rules.
// Principle: never trust the client. All authorization enforced here.
// Every temporary object (message/status) carries createdAt + expiresAt.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }
    function isParticipant(chatDoc) {
      return isSignedIn() && uid() in chatDoc.participants;
    }
    function isFriendOf(userId) {
      // Friendship doc id is the sorted pair; both members may read.
      return isSignedIn() && exists(/databases/$(database)/documents/friendships/$(sortedPair(uid(), userId)));
    }
    function sortedPair(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function validUsername(p) {
      return p.size() >= 3 && p.size() <= 20 && p.matches('^[a-zA-Z0-9_]+$');
    }

    // ---- Users ----
    match /users/{userId} {
      // Discovery model (Instagram-style): any signed-in user may read profiles
      // so they can search by username and send requests. The `email` field is
      // included for server-side validation only and is NEVER rendered by the
      // client (search/profile UIs select username, displayName, bio, photoURL).
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        // Never allow email, uid, or usernameLower mutation via the client.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'uid', 'usernameLower']);
      allow delete: if false; // deletion handled by backend/admin

      // Subcollection: notifications (per user)
      match /notifications/{nId} {
        allow read, update: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // ---- Username uniqueness registry ----
    // Publicly readable so the registration flow can check availability BEFORE
    // the user signs in (Firestore's default signed-in-only read would deny the
    // pre-auth lookup). Contains ONLY the lowercased username + owner uid — never
    // the email — so no PII is exposed by this public read.
    match /usernames/{usernameLower} {
      allow read: if true; // public, but only stores the username string
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.usernameLower == usernameLower
        && validUsername(request.resource.data.username);
      allow delete: if isSignedIn() && resource.data.uid == uid();
    }

    // ---- Friend requests ----
    // Doc id = sortedPair(sender, receiver)
    match /friendRequests/{reqId} {
      function senderId() { return request.resource.data.senderId; }
      function receiverId() { return request.resource.data.receiverId; }
      // Anyone signed in may read requests they sent or received.
      allow read: if isSignedIn()
        && (request.resource == null || true)
        && (resource == null || (uid() == resource.data.senderId || uid() == resource.data.receiverId));
      allow create: if isSignedIn()
        && senderId() == uid()
        && receiverId() != uid()
        && reqId == sortedPair(senderId(), receiverId())
        && request.resource.data.status == 'pending';
      // Only the receiver can accept/reject; only the sender can cancel.
      allow update: if isSignedIn()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.receiverId == resource.data.receiverId
            && ((uid() == resource.data.receiverId
                 && request.resource.data.status in ['accepted', 'rejected'])
                || (uid() == resource.data.senderId
                    && request.resource.data.status == 'rejected'))
          )
          // A rejected deterministic request can be reused for a fresh
          // request, including when the former receiver sends it back.
          || (resource.data.status == 'rejected'
              && uid() == request.resource.data.senderId
              && request.resource.data.receiverId != uid()
              && request.resource.data.id == reqId
              && reqId == sortedPair(request.resource.data.senderId, request.resource.data.receiverId)
              && request.resource.data.status == 'pending')
        );
      allow delete: if isSignedIn()
        && (uid() == resource.data.receiverId || uid() == resource.data.senderId);
    }

    // ---- Friendships ----
    match /friendships/{fid} {
      function isRequestParticipant() {
        return exists(/databases/$(database)/documents/friendRequests/$(fid))
          && (uid() == get(/databases/$(database)/documents/friendRequests/$(fid)).data.senderId
              || uid() == get(/databases/$(database)/documents/friendRequests/$(fid)).data.receiverId);
      }
      allow read: if isSignedIn()
        && ((resource != null && uid() in resource.data.userIds)
            // The accept transaction reads the friendship before creating it.
            // Permit that missing-document existence check only for the two
            // users in the matching request.
            || (resource == null && isRequestParticipant()));
      // The receiver may create exactly one friendship in the same atomic
      // transaction that accepts the matching request. This is the fallback
      // path for projects that have not enabled Cloud Functions billing.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/friendships/$(fid))
        && request.resource.data.id == fid
        && request.resource.data.userA != request.resource.data.userB
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds.hasAll([request.resource.data.userA, request.resource.data.userB])
        && fid == sortedPair(request.resource.data.userA, request.resource.data.userB)
        && getAfter(/databases/$(database)/documents/friendRequests/$(fid)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendRequests/$(fid)).data.senderId == request.resource.data.userA
        && getAfter(/databases/$(database)/documents/friendRequests/$(fid)).data.receiverId == request.resource.data.userB
        && getAfter(/databases/$(database)/documents/friendRequests/$(fid)).data.receiverId == uid();
      allow update, delete: if false; // managed by the accepted-request transaction
    }

    // ---- Chats ----
    match /chats/{chatId} {
      // getOrCreateChat checks whether the deterministic chat document exists
      // before creating it. A missing document contains no chat data, so allow
      // that existence check; existing chat data remains participant-only.
      allow read: if isSignedIn()
        && (resource == null || uid() in resource.data.participants);
      allow create: if isSignedIn()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isParticipant(resource.data);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == uid()
          && request.resource.data.chatId == chatId
          && 'createdAt' in request.resource.data
          && 'expiresAt' in request.resource.data
          && request.resource.data.expiresAt > request.time.toMillis() // not already expired
          // TTL is server-enforced by Cloud Functions; bound client-set expiry to <= 8 days
          && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 24 * 60 * 60 * 1000;
        allow update: if isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && (
            // receiver can mark read
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'status'])
          );
        allow delete: if false; // server-side cleanup only
      }
    }

    // ---- Statuses ----
    match /statuses/{statusId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == uid()
        && 'expiresAt' in request.resource.data
        && request.resource.data.expiresAt > request.time.toMillis();
      // Owner can read; friends (if statusVisibility allows) can read.
      allow read: if isSignedIn()
        && (request.resource.data.ownerId == uid()
            || isFriendOf(request.resource.data.ownerId));
      allow update: if isOwner(request.resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
      allow delete: if false; // server cleanup
    }
  }
}
