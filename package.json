{
  "name": "vynq-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:quality",
    "test:quality": "node scripts/quality-check.mjs",
    "verify": "npm run test:quality && npm run lint && npm run build && npm --prefix functions run lint && npm --prefix functions run build",
    "firebase:emulators": "node --use-system-ca ./node_modules/firebase-tools/lib/bin/firebase.js emulators:start",
    "firebase:deploy": "node --use-system-ca ./node_modules/firebase-tools/lib/bin/firebase.js deploy",
    "firebase:deploy:backend": "node --use-system-ca ./node_modules/firebase-tools/lib/bin/firebase.js deploy --only functions,firestore,storage,database --project vynq-chat",
    "firebase:deploy:dry-run": "node --use-system-ca ./node_modules/firebase-tools/lib/bin/firebase.js deploy --only functions,firestore,storage,database --project vynq-chat --dry-run",
    "firebase:apphosting:create": "node --use-system-ca ./node_modules/firebase-tools/lib/bin/firebase.js apphosting:backends:create --project vynq-chat --backend vynq-chat --primary-region us-central1 --root-dir .",
    "firebase:apphosting:list": "node --use-system-ca ./node_modules/firebase-tools/lib/bin/firebase.js apphosting:backends:list --project vynq-chat"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "firebase-tools": "^15.28.1",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
