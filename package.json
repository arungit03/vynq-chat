{
  "name": "vynq-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint",
    "test": "npm run test:quality",
    "test:quality": "node scripts/quality-check.mjs",
    "verify": "npm run test:quality && npm run lint && npm run build",
    "supabase:login": "supabase login",
    "supabase:db:push": "supabase db push",
    "supabase:functions:serve": "supabase functions serve cleanup-expired",
    "supabase:functions:deploy": "supabase functions deploy cleanup-expired --no-verify-jwt",
    "firebase:login": "firebase login",
    "firebase:deploy": "vite build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "firebase": "^12.18.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
